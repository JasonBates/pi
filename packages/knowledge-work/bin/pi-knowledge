#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
	SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
	SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
	[[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done

PACKAGE_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
REPO_ROOT="$(cd "$PACKAGE_ROOT/../.." && pwd)"

if [[ -f "$HOME/.zshenv" ]]; then
	source "$HOME/.zshenv"
fi

export PI_KNOWLEDGE_CONFIG="${PI_KNOWLEDGE_CONFIG:-$PACKAGE_ROOT/config/jason.json}"
export PI_KNOWLEDGE_VAULT="${PI_KNOWLEDGE_VAULT:-$HOME/Obsidian/VAULTS/Trinity}"
export PI_SKIP_VERSION_CHECK="${PI_SKIP_VERSION_CHECK:-1}"

DASHBOARD_ARGS=()
if [[ "${PI_KNOWLEDGE_DASHBOARD:-1}" != "0" ]]; then
	DASHBOARD_BRIDGE="${PI_KNOWLEDGE_DASHBOARD_BRIDGE:-$HOME/.pi/agent/npm/node_modules/@blackbelt-technology/pi-dashboard-extension/src/bridge.ts}"
	if [[ ! -f "$DASHBOARD_BRIDGE" ]]; then
		DASHBOARD_BRIDGE="$HOME/.pi/agent/npm/node_modules/@blackbelt-technology/pi-agent-dashboard/packages/extension/src/bridge.ts"
	fi
	if [[ -f "$DASHBOARD_BRIDGE" ]]; then
		DASHBOARD_ARGS=(
			--extension "$PACKAGE_ROOT/src/dashboard-wikilinks.ts"
			--extension "$DASHBOARD_BRIDGE"
		)
	else
		printf 'pi-knowledge: dashboard bridge not found; continuing without dashboard\n' >&2
	fi
fi

cd "$PI_KNOWLEDGE_VAULT"
exec "$REPO_ROOT/pi-test.sh" \
	--quiet-startup \
	--no-builtin-tools \
	--no-extensions \
	--no-skills \
	--no-prompt-templates \
	--no-themes \
	--system-prompt "$PACKAGE_ROOT/system-prompt.md" \
	"${DASHBOARD_ARGS[@]}" \
	--extension "$PACKAGE_ROOT" \
	"$@"
